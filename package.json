{
  "name": "pi-agent-extensions",
  "version": "7.1.1",
  "description": "Comprehensive engineering extensions suite for Pi Coding Agent",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "mcp",
    "browser"
  ],
  "pi": {
    "extensions": [
      "./*.ts",
      "./mcp/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "typebox": "1.3.34"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && tsx --test parallel-agent/__tests__/*.test.ts && tsx --test work-mode/__tests__/*.test.ts lib/__tests__/*.test.ts __tests__/*.test.ts && tsx --test stream-compat/__tests__/*.test.ts"
  }
}
